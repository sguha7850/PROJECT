#Ranganathan_VAMoS2 (1) -  Au/VA-MoS2/Si memristor - Large-Scale and Robust Multifunctional Vertically Aligned MoS2 Photo-Memristors -  https://doi.org/10.1002/adfm.202005718
import numpy as np
import matplotlib.pyplot as plt

# --- 1. Physical Constants ---
k_B = 8.617e-5          # Boltzmann constant (eV/K)
T = 300                 # Temperature (K)
G0 = 10**(-3.62)              # DP1 conductance
L = 35e-9               # Device thickness (7 nm)

# --- 2. Model Parameters (Updated for Ea = 2.0 eV) ---
# Ea = 2.0              # NEW: High Activation Energy (2 eV)
beta = 11e-9            # Field coupling constant (eV*m/V)
k_attempt = 3e7         # Attempt frequency (Hz)

# Schottky Parameters (Initial 2H Phase)
Is = 1e-6
n_set =11
n_reset = 17
vt = 0.026

# Metallic Parameters (Final 1T' Phase)
N_channels = 1
G_metallic = N_channels * G0

s_set = 4.5
s_reset = 5

freq = 1e3                          # 1 kHz
t = np.linspace(0, 1 / freq, 25000)

V_max = 4
V_signal = V_max * np.sin(2 * np.pi * freq * t)

# Scale negative part
V_signal[V_signal < 0] *= 3/4

dt = t[1] - t[0]

# plt.plot(t, V_signal)
# plt.show()


class MoTe2:
    def __init__(self):
        self.v_off = 0.1
        self.v_on = -0.1

        self.Eset = 0.5
        self.Ereset = 1

        self.w_off = 10e-9
        self.w_on = 0.0

        self.w_init = 0      # Starts in OFF state
        self.w = self.w_init

        self.p_set = 5
        self.p_reset = 3

    def dw_dt(self, v):

        if v > self.v_off:

            window = (1 - self.w) ** self.p_set

            return (
                k_attempt
                * np.exp(
                    (-(self.Eset - beta * (v / L))) / (k_B * T)
                )
                * window
            )

        elif v < self.v_on:

            # Using -(self.w**p) to ensure a negative rate for RESET
            window = -(self.w) ** self.p_reset

            return (
                k_attempt
                * np.exp(
                    (-(self.Ereset - beta * (abs(v / L))))
                    / (k_B * T)
                )
                * window
            )

        else:
            return 0


memristor = MoTe2()

current = []
state = []
derivative = []

for v in V_signal:

    dw_val = memristor.dw_dt(v)

    derivative.append(dw_val)

    memristor.w = np.clip(
        memristor.w + dw_val * dt,
        0,
        1
    )

    state.append(memristor.w)

    if v >= 0:
        n_current = n_set
    else:
        n_current = n_reset

    # I_sch = Is * (exp(v/nVt) - 1)
    # (Thermionic emission current)

    I_sch = (
        Is
        * (np.exp(np.abs(v) / (n_current * vt)) - 1)
        * np.sign(v)
    )

    I_met = G_metallic * v

    # Total current blending
    I_total = (
        (1 - memristor.w) * I_sch
        + memristor.w * I_met
    )

    I_clipped = np.maximum(np.abs(I_total), 1e-13)

    current.append(I_clipped)

